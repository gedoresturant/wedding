# Local/LAN application server
PORT=3000
HOST=0.0.0.0
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
NODE_ENV=development
APP_INSTANCE_ID=local-office-01
SYNC_MODE=disabled

# Supabase project configuration (server-side only; never expose service role key to browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SYNC_ENABLED=false
SUPABASE_SYNC_INTERVAL_MS=15000
